---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { lessonPath, modulePath, modules, publishedLessons } from '../../course';

export async function getStaticPaths() {
  const lessons = await publishedLessons();
  return lessons.map((lesson, index) => ({
    params: { slug: lesson.data.slug },
    props: { lesson, prev: lessons[index - 1], next: lessons[index + 1] },
  }));
}
const { lesson, prev, next } = Astro.props;
const { data } = lesson;
const module = modules.find(({ slug }) => slug === data.module)!;
const breadcrumbs = [
  { name: 'SEO Практика', path: '/' },
  { name: module.title, path: modulePath(module.slug) },
];
const breadcrumbJson = Astro.site && JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [...breadcrumbs, { name: data.title, path: lessonPath(data.slug) }]
    .map(({ name, path }, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name,
      item: new URL(path, Astro.site).href,
    })),
}).replaceAll('<', '\\u003c');
const { Content, headings } = await render(lesson);
const date = new Intl.DateTimeFormat('ru', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(data.checked));
---
<Base title={data.title} description={data.description}>
  {breadcrumbJson && <script is:inline type="application/ld+json" set:html={breadcrumbJson} />}
  <div class="wrap lesson-layout">
    <article class="reading">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        {breadcrumbs.map(({ name, path }) => <a href={path}>{name}</a>)}
      </nav>
      <h1>{data.title}</h1>
      <p class="intro">{data.description}</p>
      <div class="prose"><Content /></div>
      <p class="checked">Источники проверены <time datetime={data.checked}>{date}</time></p>
      <nav class="pager" aria-label="Соседние уроки">
        {prev && <a href={lessonPath(prev.data.slug)}><small>Предыдущий урок</small>{prev.data.title}</a>}
        {next && <a href={lessonPath(next.data.slug)}><small>Следующий урок</small>{next.data.title}</a>}
      </nav>
    </article>
    <aside class="contents"><nav aria-label="Оглавление урока">
      <h2>В этом уроке</h2>
      <ul>{headings.filter(({ depth }) => depth === 2).map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}</ul>
    </nav></aside>
  </div>
</Base>
