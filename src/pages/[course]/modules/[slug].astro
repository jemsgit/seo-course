---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { courseCatalog } from '../../../courses/catalog';
import { coursePath, lessonPath, modulePath } from '../../../courses/registry';

export async function getStaticPaths() {
  const catalog = await courseCatalog();
  return catalog.flatMap(({ course, modules }) => course.modulePages
    ? modules.filter(({ lessons }) => lessons.length).map((module) => ({
        params: { course: course.slug, slug: module.slug },
        props: { course, module },
      }))
    : []);
}

const { course, module } = Astro.props;
const entries = module.lessons;
const description = entries.map(({ data }) => data.title).join(' · ');
---
<Base course={course} title={module.title} description={description}>
  <div class="wrap reading">
    <Breadcrumbs class="breadcrumbs" items={[
      { name: course.name, path: coursePath(course.slug) },
      { name: module.title, path: modulePath(course.slug, module.slug) },
    ]} />
    <h1>{module.title}</h1>
    <h2>Уроки</h2>
    <ol>{entries.map(({ data }) => <li><a href={lessonPath(course.slug, data.slug)}>{data.title}</a><p>{data.description}</p></li>)}</ol>
    {module.assignment && <section class="exercise">
      <h2>Итоговое задание</h2>
      <p>{module.assignment}</p>
    </section>}
  </div>
</Base>
