---
import Base from '../layouts/Base.astro';
import { courses, coursePath } from '../courses/registry';
---
<Base hub title="Курсы для веб-разработчиков" description="Практический курс по SEO и интерактивный учебник Redux Toolkit и RTK Query.">
  <section class="wrap reading">
    <h1>Курсы для веб-разработчиков</h1>
    {courses.map((course) => <section class="module">
      <h2><a href={coursePath(course.slug)}>{course.name}</a></h2>
      <p>{course.summary}</p>
    </section>)}
  </section>
</Base>
