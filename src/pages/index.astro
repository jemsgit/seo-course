---
import Base from '../layouts/Base.astro';
import { lessonPath, modulePath, modules, publishedLessons } from '../course';
const lessons = await publishedLessons();
const stages = [
  ['Обнаружение', 'Робот узнаёт URL из ссылки или карты сайта.'],
  ['Обход', 'Робот запрашивает страницу.'],
  ['Индексирование', 'Поисковик решает, включать ли страницу в индекс.'],
  ['Выдача', 'Поисковик подбирает страницы для запроса.'],
];
---
<Base title="SEO для веб-разработчиков" description="Практический курс по SEO для Google и Яндекса. От обхода и индексирования до продвижения и анализа трафика.">
  <div class="wrap hero">
    <div>
      <h1>SEO для<br />веб-разработчиков</h1>
      <p class="intro">Как Google и Яндекс находят страницы и показывают их в выдаче. Разбираемся на сайте самого курса.</p>
      {lessons[0] && <a class="button" href={lessonPath(lessons[0].data.slug)}>Начать первый урок</a>}
    </div>
    <figure class="pipeline">
      <figcaption>Путь страницы в поиск</figcaption>
      <ol>{stages.map(([title, description]) => <li><strong>{title}</strong><span>{description}</span></li>)}</ol>
    </figure>
  </div>
  <section class="wrap program" id="program">
    <h2>Программа курса</h2>
    {modules.map((module) => {
      const entries = lessons.filter(({ data }) => data.module === module.slug);
      return <section class="module">
        <h3>{entries.length ? <a href={modulePath(module.slug)}>{module.title}</a> : module.title}</h3>
        {entries.length ? <ol>{entries.map(({ data }) => <li><a href={lessonPath(data.slug)}>{data.title}</a></li>)}</ol> : <p>Готовится</p>}
      </section>;
    })}
  </section>
</Base>
