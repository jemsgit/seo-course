---
import Base from '../../layouts/Base.astro';
import { lessonPath, modules, publishedLessons } from '../../course';

export async function getStaticPaths() {
  const lessons = await publishedLessons();
  return modules.flatMap((module) => {
    const entries = lessons.filter(({ data }) => data.module === module.slug);
    return entries.length ? [{ params: { slug: module.slug }, props: { module, entries } }] : [];
  });
}
const { module, entries } = Astro.props;
const description = entries.map(({ data }) => data.title).join(' · ');
---
<Base title={module.title} description={description}>
  <div class="wrap reading">
    <nav aria-label="Хлебные крошки"><a href="/#program">Программа</a></nav>
    <h1>{module.title}</h1>
    <h2>Уроки</h2>
    <ol>{entries.map(({ data }) => <li><a href={lessonPath(data.slug)}>{data.title}</a><p>{data.description}</p></li>)}</ol>
    {module.slug === 'search-basics' && <section class="exercise">
      <h2>Итоговое задание</h2>
      <p>Выберите страницу своего сайта. Найдите ссылку, по которой робот может на неё попасть, проверьте HTTP-ответ и узнайте статус URL в обеих панелях.</p>
    </section>}
  </div>
</Base>
