---
import '../styles/global.css';
const { title, description } = Astro.props;
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html><html lang="ru"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} · Redux по шагам</title><meta name="description" content={description}/>{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="article"/><meta property="og:locale" content="ru_RU"/>{canonical && <meta property="og:url" content={canonical}/>}{!canonical ? <meta name="robots" content="noindex"/> : null}<meta name="theme-color" content="#faf9f6"/><link rel="icon" href="/redux/favicon.svg" type="image/svg+xml"/></head><body><a class="skip" href="#main">Перейти к содержанию</a><header class="header"><a class="brand" href="/redux/"><span class="brand-icon">↻</span> redux<span class="brand-sub">по шагам</span></a><nav aria-label="Основная навигация"><a href="/redux/">Программа</a><a href="/">Все курсы</a><a href="https://redux.js.org/">Документация ↗</a></nav><span class="edition">Интерактивный учебник · RU</span></header><slot/><footer><a class="brand" href="/redux/">redux / по шагам</a><p>Учимся понимать состояние. Один шаг за раз.</p><a href="https://redux.js.org/">На основе официальной документации Redux ↗</a></footer></body></html>
